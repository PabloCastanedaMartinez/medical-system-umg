# Directorio persistente de adjuntos (relativo al directorio de ejecución).
DOCUMENTS_DIRECTORY=uploads/documents

DB_HOST=localhost
# Opcional en local; obligatorio en prod. Si se define, prevalece sobre host/puerto/nombre.
# DB_URL=jdbc:postgresql://localhost:5433/cecamed_backend
DB_NAME=cecamed_backend
DB_USERNAME=cecamed_backend
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5433
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Seguridad e Identidad (Fase 2)
# Clave HMAC-SHA256 para firma de JWT (mínimo 32 caracteres / 256 bits).
JWT_SECRET=local-dev-jwt-secret-key-that-must-be-at-least-256-bits-long-32-chars!
# Administrador inicial opcional (solo se crea si se definen ambos y la contraseña tiene >= 12 caracteres).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=adminPassword123!
BOOTSTRAP_ADMIN_FULL_NAME=Administrador del Sistema

