# Copiar como .env.local solo si necesitas cambiar los valores por defecto.

# Prefijo de la API cuando el frontend NO usa el proxy de Vite (p. ej. en producción en otro dominio).
# Por defecto: /api/v1 (mismo origen o proxy de Vite).
# VITE_API_BASE_URL=https://cecamed.ejemplo.com/api/v1

# Activa la API simulada en el navegador (equivale a `npm run dev:mock`).
# VITE_USE_MOCK=true
